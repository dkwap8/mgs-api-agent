APP_NAME="MGS Payments"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mgs.com.ng
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mgs_payments
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=redis
CACHE_PREFIX=mgs-payments-cache-
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.mgs.com.ng
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=mgs-payments-database-
REDIS_PERSISTENT=false
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@mgs.com.ng"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=mgs.com.ng

CORS_ALLOWED_ORIGINS=https://mgs.com.ng,https://www.mgs.com.ng
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=600

PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_SECRET_KEY=
PROVIDER_WEBHOOK_SECRET=
PROVIDER_TIMEOUT=30
WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
WEBHOOK_TIMESTAMP_TOLERANCE=300
WEBHOOK_DELIVERY_TIMEOUT=15
WEBHOOK_DELIVERY_ATTEMPTS=5

WITHDRAWAL_OTP_TTL=10
REGISTRATION_OTP_TTL=10
MAX_LOGIN_ATTEMPTS=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional one-time administrator provisioning with: php artisan db:seed --class=AdminSeeder
ADMIN_NAME="Platform Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_REQUIRE_MFA=true

# Identity verification provider
KYC_DRIVER=http
KYC_PROVIDER_NAME=configured-http
KYC_BASE_URL=
KYC_AUTH_SCHEME=bearer
KYC_API_KEY=
KYC_API_SECRET=
KYC_API_KEY_HEADER=X-API-Key
KYC_NIN_ENDPOINT=/verify/nin
KYC_BVN_ENDPOINT=/verify/bvn
KYC_CONNECT_TIMEOUT=10
KYC_TIMEOUT=30
KYC_MAXIMUM_ATTEMPTS=8
KYC_RETRY_DELAY_MINUTES=10
KYC_DUPLICATE_SCOPE=platform
KYC_RESPONSE_STATUS_PATH=status
KYC_RESPONSE_MESSAGE_PATH=message
KYC_RESPONSE_NAME_PATH=data.name
KYC_RESPONSE_DOB_PATH=data.date_of_birth
KYC_RESPONSE_REFERENCE_PATH=data.reference
